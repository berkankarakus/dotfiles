# C# / Neovim için sade, okunaklı Ghostty profili.
theme = TokyoNight Moon
font-family = JetBrainsMono Nerd Font
font-feature = calt, liga
font-size = 14
window-padding-x = 10
window-padding-y = 8
window-decoration = auto
window-inherit-font-size = true
keybind = option+backspace=esc:d
keybind = option+delete=esc:d
keybind = command+arrow_left=csi:H
keybind = command+arrow_right=csi:F
